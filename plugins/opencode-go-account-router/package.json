{
  "name": "opencode-go-account-router",
  "version": "0.1.0",
  "description": "Persistent, quota-aware account routing plugin for OpenCode 1.18 and CloudCLI",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "bin": { "opencode-go-router": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": { "proper-lockfile": "4.1.2" },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.4",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3"
  }
}
